@using Microsoft.AspNetCore.Components.Web
@namespace MyToDoBlazorApp.Pages
@using Microsoft.EntityFrameworkCore
@using BlazorApp.Models

@page "/todo-list"
@inject HttpClient Http

<h3>Todo List</h3>
<div class="card">
    <div class="card-header">
        <h4>Tasks</h4>
    </div>
    <div class="card-body">
        <ul class="list-group">
            @foreach (var todo in TodoItems)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@todo.Title - @(todo.IsCompleted ? "Completed" : "Pending")</span>
                    <div>
                        <button class="btn btn-sm btn-primary me-2" @onclick="() => Edit(todo)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(todo.Id)">Delete</button>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h4>Add New Todo</h4>
    </div>
    <div class="card-body">
        <EditForm Model="newTodo" OnValidSubmit="AddTodo">
            <div class="mb-3">
                <InputText class="form-control" @bind-Value="newTodo.Title" placeholder="Title" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="newTodo.IsCompleted" />
                <label class="form-check-label">Completed</label>
            </div>
            <button class="btn btn-primary" type="submit">Add</button>
        </EditForm>
    </div>
</div>

@if (selectedTodo != null)
{
    <div class="card mt-4">
        <div class="card-header">
            <h4>Edit Todo</h4>
        </div>
        <div class="card-body">
            <EditForm Model="selectedTodo" OnValidSubmit="SaveEdit">
                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="selectedTodo.Title" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="selectedTodo.IsCompleted" />
                    <label class="form-check-label">Completed</label>
                </div>
                <button class="btn btn-success" type="submit">Save</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<TodoItem> TodoItems = new();
    private TodoItem newTodo = new();
    private TodoItem? selectedTodo;

    protected override async Task OnInitializedAsync()
    {
        TodoItems = await Http.GetFromJsonAsync<List<TodoItem>>("https://localhost:7208/api/Todo");
    }

    private async Task AddTodo()
    {
        await Http.PostAsJsonAsync("https://localhost:7208/api/Todo", newTodo);
        newTodo = new TodoItem();
        TodoItems = await Http.GetFromJsonAsync<List<TodoItem>>("https://localhost:7208/api/Todo");
    }

    private void Edit(TodoItem todo)
    {
        selectedTodo = todo;
    }

    private async Task SaveEdit()
    {
        if (selectedTodo != null)
        {
            await Http.PutAsJsonAsync($"https://localhost:7208/api/Todo/{selectedTodo.Id}", selectedTodo);
            selectedTodo = null;
            TodoItems = await Http.GetFromJsonAsync<List<TodoItem>>("https://localhost:7208/api/Todo");
        }
    }

    private async Task Delete(int id)
    {
        await Http.DeleteAsync($"https://localhost:7208/api/Todo/{id}");
        TodoItems = await Http.GetFromJsonAsync<List<TodoItem>>("https://localhost:7208/api/Todo");
    }
}
